{
  "name": "blackbox-agent-c",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/api' --filter './packages/mcp' run build",
    "build:backend": "pnpm --filter @blackbox/database --filter @blackbox/logging --filter @blackbox/auth --filter @blackbox/application --filter @blackbox/testing --filter @blackbox/api --filter @blackbox/mcp run build",
    "typecheck:backend": "pnpm --filter @blackbox/database --filter @blackbox/logging --filter @blackbox/auth --filter @blackbox/application --filter @blackbox/testing --filter @blackbox/api --filter @blackbox/mcp run typecheck",
    "test:backend": "vitest run --config tests/backend/vitest.unit.config.ts",
    "test:backend:integration": "vitest run --config tests/backend/vitest.integration.config.ts",
    "db:migrate": "node apps/api/dist/cli.js migrate",
    "db:bootstrap": "node packages/database/dist/bootstrap.js",
    "build:web": "pnpm --filter web build",
    "build:landing": "pnpm --filter landing build",
    "typecheck:ui": "pnpm --filter web typecheck && pnpm --filter landing typecheck && pnpm --filter e2e typecheck",
    "check:locales": "pnpm --filter @blackbox/i18n check",
    "mock:api": "pnpm --filter web mock",
    "e2e": "pnpm --filter web build && pnpm --filter landing build && pnpm --filter e2e test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "4.1.12",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "@types/pg": "8.23.1"
  }
}
