{
  "name": "@blackbox/connectors",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral source adapters, normalized observations, mapping to journal tracks and the worker-side ingestion client (append via append_journal_entries only).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "8.23.1",
    "@blackbox/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
