tests/e2e/test-results
tests/e2e/playwright-report
tests/e2e/screenshots
tests/e2e/.auth
target
.git
.local
data
backups
release
reference
reports
docs
specs/*
!specs/question-data-contracts.json
integrations
features
templates
benchmarks
fixtures/**/*.bin
*.log
.env*
!.env.example
