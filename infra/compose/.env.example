# Blackbox local pilot — non-secret configuration. ./blackbox setup generates <install>/.env from
# this template. Secrets never live here; they are files under BLACKBOX_SECRETS_DIR (0700/0600).
# Changing values by hand is supported only for the entries marked "owner-editable".

# Compose project / container-name prefix. Keep distinct per concurrent installation.
COMPOSE_PROJECT_NAME=blackbox-agent-c

# Release version baked into image tags (from release.json; "dev" for a source checkout build).
BLACKBOX_VERSION=dev
BLACKBOX_IMAGE_PREFIX=blackbox
BLACKBOX_POSTGRES_IMAGE=postgres:16.6-alpine@sha256:1d04b9ba1d4996401f2552b51beda8187f175c0645c091e4781134fc9c9a3eef

# Loopback only. Any other value is refused by the wrapper: public/LAN binding is unsupported.
BLACKBOX_BIND=127.0.0.1
# Host port for the browser UI/API (owner-editable; keep within 19180-19189 for A/B pilots).
BLACKBOX_PORT=19180

# Absolute host paths filled in by setup.
BLACKBOX_RELEASE_DIR=/absolute/path/to/install
BLACKBOX_DATA_DIR=/absolute/path/to/install/data
BLACKBOX_SECRETS_DIR=/absolute/path/to/install/secrets
BLACKBOX_MIGRATIONS_DIR=/absolute/path/to/install/migrations

# Enrolled backup destination (set by ./blackbox backup-config; empty = not configured/unprotected).
BLACKBOX_BACKUP_DESTINATION=

# owner-editable: info|warn|error (debug only through the diagnostics UI, bounded to 15 minutes)
BLACKBOX_LOG_LEVEL=info
BLACKBOX_TZ=UTC
# owner-editable memory ceilings for the container runtime
BLACKBOX_API_MEM_LIMIT=1024m
BLACKBOX_WORKER_MEM_LIMIT=1024m
BLACKBOX_ENGINE_MEM_LIMIT=1536m
