# Non-secret configuration template for the Blackbox local pilot (generated per installation by ./blackbox setup).
# Secrets live as files under <install>/secrets (0700/0600) and are never placed here.
COMPOSE_PROJECT_NAME=blackbox-agent-c
BLACKBOX_VERSION=dev
BLACKBOX_IMAGE_PREFIX=blackbox
BLACKBOX_POSTGRES_IMAGE=postgres:16.6-alpine@sha256:1d04b9ba1d4996401f2552b51beda8187f175c0645c091e4781134fc9c9a3eef
BLACKBOX_BIND=127.0.0.1
BLACKBOX_PORT=19180
BLACKBOX_PGDATABASE=blackbox
BLACKBOX_RELEASE_DIR=/path/to/release
BLACKBOX_DATA_DIR=/path/to/install/data
BLACKBOX_SECRETS_DIR=/path/to/install/secrets
BLACKBOX_MIGRATIONS_DIR=/path/to/release/migrations
BLACKBOX_BACKUP_DESTINATION=
BLACKBOX_LOG_LEVEL=info
BLACKBOX_TZ=UTC
BLACKBOX_API_MEM_LIMIT=1024m
BLACKBOX_WORKER_MEM_LIMIT=1024m
BLACKBOX_ENGINE_MEM_LIMIT=1536m
