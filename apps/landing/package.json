{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "description": "Independently servable static landing page with the Mac download driven by release-manifest.json (fetched at runtime from the same directory).",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 19181 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 19181 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@blackbox/i18n": "workspace:*",
    "@blackbox/ui": "workspace:*",
    "i18next": "25.10.10"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "5.4.19"
  }
}
