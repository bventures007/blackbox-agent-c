{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Blackbox local browser UI (React 18 + Vite 5). Built output in dist/ is served by apps/api at /.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 19180 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 19180 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mock": "node ./mock/server.mjs"
  },
  "dependencies": {
    "@blackbox/i18n": "workspace:*",
    "@blackbox/ui": "workspace:*",
    "i18next": "25.10.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.19"
  }
}
