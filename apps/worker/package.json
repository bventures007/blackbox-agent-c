{
  "name": "@blackbox/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blackbox connector worker: pg-boss jobs for outbox dispatch, provider polling/backfill/reconciliation, credential checks, backups, retention and heartbeat. Binds no listener.",
  "main": "./dist/index.js",
  "bin": { "blackbox-worker": "./dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "fixture:shopify": "node ../../fixtures/shopify/server.mjs"
  },
  "dependencies": {
    "@blackbox/connectors": "workspace:*",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
